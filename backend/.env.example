# Copy to ".env" (same folder as pom.xml) and fill in real values. ".env" is git-ignored.
# Spring Boot loads it automatically when started from the backend/ directory.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elrics_portal
DB_USERNAME=elrics_user
DB_PASSWORD=change-me

# --- JWT (REQUIRED, at least 32 characters). Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access-token lifetime in milliseconds (default 3600000 = 1 hour)
JWT_EXPIRATION_MS=3600000

# --- Server / CORS ---
SERVER_PORT=8080
# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# --- Optional ---
# HIBERNATE_DDL_AUTO=validate
# SWAGGER_ENABLED=true
# APP_LOG_LEVEL=INFO

# --- Only used by the MySQL-backed integration tests (mvn test) ---
# TEST_DB_HOST=localhost
# TEST_DB_PORT=3306
# TEST_DB_NAME=elrics_portal_test
# TEST_DB_USERNAME=root
# TEST_DB_PASSWORD=
